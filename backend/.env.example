# CoalGuard.AI backend — local development configuration.
# Copy to `.env`. Never commit populated secrets.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# PostgreSQL 16. `npm run db:start` starts an embedded cluster on this URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/coalguard

# development = local identity adapter (no passwords, NOT production auth).
# oidc = reserved for Keycloak; token exchange is not implemented in this build.
AUTH_MODE=development
AUTH_TOKEN_TTL_MINUTES=480
AUTH_COOKIE_NAME=coalguard_session

# Comma separated exact origins. No wildcard is used.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000

# Label returned in API metadata. Seeded datasets must remain `development`.
DATA_PROVENANCE=development
ALLOW_DEV_SEED=true

# Private local file roots. Documents and report artifacts are never served
# from a public static directory.
STORAGE_DIR=.data/documents
REPORT_DIR=.data/reports

# Optional ISO date (YYYY-MM-DD) used to make deadline evaluation deterministic.
# Leave blank in normal operation.
COALGUARD_TODAY=

# Request limits and rate limiting (single-instance in-memory store).
BODY_LIMIT_BYTES=1048576
DOCUMENT_MAX_BYTES=5242880
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute

# Background reminder loop. Set to false and run `npm run jobs:tick` from a
# durable scheduler in a multi-instance deployment.
ENABLE_INPROCESS_SCHEDULER=false
SCHEDULER_INTERVAL_SECONDS=300

LOG_LEVEL=info
