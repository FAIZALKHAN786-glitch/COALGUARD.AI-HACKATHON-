# ---------------------------------------------------------------------------
# CoalGuard.AI environment configuration
# Copy to `.env.local` for local development. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Data source mode -------------------------------------------------------
# `development`  -> deterministic in-browser development adapter (demo data)
# `api`          -> talk to the CoalGuard backend over HTTP
NEXT_PUBLIC_DATA_SOURCE=development

# Base URL of the CoalGuard backend REST API. Only used when
# NEXT_PUBLIC_DATA_SOURCE=api. Leave empty for the development adapter.
NEXT_PUBLIC_API_BASE_URL=

# --- Public map configuration ------------------------------------------------
# Public (browser-safe) Mapbox access token. This is a PUBLIC token by design
# and must be restricted by URL scoping in the Mapbox dashboard. Never put
# server-side secrets in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Map style used by the GIS module. Default style ships without a token
# requirement only if a valid token is supplied.
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# --- Identity provider ------------------------------------------------------
# `development` -> clearly-labelled local development identities (NOT secure)
# `oidc`        -> redirect to an external OIDC/Keycloak authority
NEXT_PUBLIC_AUTH_MODE=development

# Public OIDC authority URL (Keycloak realm). Server-only credential exchange
# must happen in a Next.js Route Handler, never in the browser.
NEXT_PUBLIC_OIDC_AUTHORITY=
NEXT_PUBLIC_OIDC_CLIENT_ID=

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=CoalGuard.AI
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ============================================================================
# BACKEND SERVER CONFIGURATION (server-side only - never expose to browser)
# ============================================================================

NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# PostgreSQL 16
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/coalguard

# Auth
AUTH_MODE=development
AUTH_TOKEN_TTL_MINUTES=480
AUTH_COOKIE_NAME=coalguard_session

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000

# Data provenance
DATA_PROVENANCE=development
ALLOW_DEV_SEED=true

# Storage
STORAGE_DIR=.data/documents
REPORT_DIR=.data/reports

# Request limits
BODY_LIMIT_BYTES=1048576
DOCUMENT_MAX_BYTES=5242880
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute

# Scheduler
ENABLE_INPROCESS_SCHEDULER=false
SCHEDULER_INTERVAL_SECONDS=300

LOG_LEVEL=info

# ============================================================================
# MODEL CREDENTIALS (server-side only - NEVER expose to browser)
# ============================================================================
# Three logical credential slots for model providers:
# 1. PREDICTIVE_AI_API_KEY - credentials for predictive AI/model provider
# 2. CHATBOT_API_KEY - credentials for conversational LLM provider
# 3. REASONING_MODEL_API_KEY - credentials for reasoning-model provider
#
# These are API keys, not model identifiers. Configure according to your
# selected provider(s). If one provider supplies multiple models through one
# credential, a single key may serve multiple roles.
#
# Leave empty to trigger clear startup configuration errors instead of
# silently falling back to simulated responses.
PREDICTIVE_AI_API_KEY=
CHATBOT_API_KEY=
CHATBOT_BASE_URL=https://api.openai.com/v1
CHATBOT_MODEL=gpt-3.5-turbo
REASONING_MODEL_API_KEY=

# ============================================================================
# AI SERVICE CONFIGURATION (ai-service/ - FastAPI Python service)
# ============================================================================

# AI service database URL (shares PostgreSQL with backend)
COALGUARD_AI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55432/coalguard

# AI service auth
COALGUARD_AI_AUTH_MODE=development
COALGUARD_AI_JWT_SECRET=dev-secret-change-in-production
COALGUARD_AI_JWT_ALGORITHM=HS256
COALGUARD_AI_JWT_EXPIRY_MINUTES=480

# AI service CORS
COALGUARD_AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COALGUARD_AI_LOG_LEVEL=INFO

# OCR
COALGUARD_AI_OCR_LANGUAGES=eng
# Supported OCR languages (comma-separated ISO 639-2 codes):
#   eng=English, hin=Hindi, tam=Tamil, tel=Telugu, mar=Marathi,
#   guj=Gujarati, kan=Kannada, mal=Malayalam, pan=Punjabi,
#   ory=Odia, asm=Assamese, urd=Urdu, ben=Bengali
# Example: COALGUARD_AI_OCR_LANGUAGES=eng,hin,tam
COALGUARD_AI_OCR_LANGUAGES=eng
COALGUARD_AI_MAX_BYTES=5242880
COALGUARD_AI_MAX_PAGES=50

# Search (web research)
COALGUARD_AI_SEARCH_PROVIDER=mock
COALGUARD_AI_SEARCH_API_KEY=
COALGUARD_AI_RESEARCH_MAX_RESULTS=10

# Workflow limits
COALGUARD_AI_WORKFLOW_MAX_DURATION_MINUTES=60
COALGUARD_AI_WORKFLOW_MAX_TOOL_CALLS=50

# Vector DB (ChromaDB for RAG)
COALGUARD_AI_CHROMA_PATH=./chroma_db
COALGUARD_AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================================
# EVENT STREAMING (Kafka)
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=coalguard-ai

# ============================================================================
# TEMPORAL WORKFLOW ORCHESTRATION
# ============================================================================
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=coalguard
